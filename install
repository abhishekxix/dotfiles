#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.realpath(__file__))
PROFILE_DEFAULT = "workstation"
PROFILES = ("workstation", "server")
COLLECTION_FLOOR = (10, 7, 0)

USAGE = """Usage: ./install [--profile NAME] [ansible-playbook options]

Configure this machine via Ansible (Debian stable only).

Profiles:
  --profile NAME, --profile=NAME
      workstation   Full set: GUI apps + CLI tools (default).
      server        Headless set: CLI tools only.

Help:
  -h, --help        Show this help and exit.

Passthrough (anything else is forwarded to ansible-playbook):
  --tags packages|dotfiles
                    Run only app installs or only dotfile linking.
  --check --diff    Preview changes without applying them.
  --skip-tags packages
                    Limit a run to dotfile linking (no package installs).
  -e KEY=VALUE, --extra-vars KEY=VALUE
                     Extra Ansible variables. A value containing
                     dotfiles_profile overrides --profile. Only the
                     values on the command line are inspected:
                     -e @file.yml indirection is not detected, but
                     the file still wins because passthrough args
                     follow the injected default (later -e wins).
  -K, --ask-become-pass, --become-password-file FILE
                    Become-password options. The wrapper adds
                    --ask-become-pass unless you pass one of these.

Wrapper behavior:
  - Installs ansible via apt when ansible-playbook is missing
    (Debian ID=debian only; uses sudo when available).
  - Installs (or upgrades to >=10.7.0) the community.general
    collection from ansible/requirements.yml when needed.
  - Runs ansible-playbook from the repo root with the selected
    profile forwarded as -e dotfiles_profile=NAME.
  - Conflicting dotfiles are backed up under
    ~/.local/state/dotfiles/backups/<timestamp>/ before linking.
    Re-runs are idempotent.

Examples:
  ./install
  ./install --profile server
  ./install --tags dotfiles
  ./install --tags packages
  ./install --check --diff --skip-tags packages
  ./install --profile server --tags packages
"""


def usage_error():
    sys.stderr.write(USAGE)


def run(cmd):
    try:
        proc = subprocess.run(cmd)
    except OSError as exc:
        print(f"Failed to run {cmd[0]}: {exc}", file=sys.stderr)
        sys.exit(1)
    if proc.returncode != 0:
        sys.exit(proc.returncode)


def prescan(argv):
    saw_become_pass = False
    extra_vals = []
    prev_was_extra = False
    for arg in argv:
        if prev_was_extra:
            extra_vals.append(arg)
            prev_was_extra = False
            continue
        if (
            arg == "--ask-become-pass"
            or arg.startswith("--ask-become-pass=")
            or arg == "--become-password-file"
            or arg.startswith("--become-password-file=")
            or arg.startswith("-K")
        ):
            saw_become_pass = True
        elif arg in ("-e", "--extra-vars"):
            prev_was_extra = True
        elif arg.startswith("--extra-vars="):
            extra_vals.append(arg[len("--extra-vars="):])
        elif arg.startswith("-e"):
            extra_vals.append(arg[2:])
    saw_profile_e = any("dotfiles_profile" in val for val in extra_vals)
    return saw_become_pass, saw_profile_e


def parse(argv):
    profile = PROFILE_DEFAULT
    passthrough = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--profile":
            if i + 1 >= len(argv):
                usage_error()
                sys.exit(1)
            profile = argv[i + 1]
            i += 2
        elif arg.startswith("--profile="):
            profile = arg[len("--profile="):]
            i += 1
        elif arg in ("-h", "--help"):
            sys.stdout.write(USAGE)
            sys.exit(0)
        else:
            passthrough.append(arg)
            i += 1
    return profile, passthrough


def version_key(version):
    parts = []
    for comp in version.split("."):
        digits = ""
        for ch in comp:
            if ch.isdigit():
                digits += ch
            else:
                break
        if not digits or digits != comp:
            return (-1,)
        parts.append(int(digits))
    return tuple(parts)


def below_floor(have):
    key = version_key(have)
    if key[0] < 0:
        return True
    for h, f in zip(key, COLLECTION_FLOOR):
        if h != f:
            return h < f
    return len(key) < len(COLLECTION_FLOOR)


def collection_version():
    try:
        proc = subprocess.run(
            [
                "ansible-galaxy",
                "collection",
                "list",
                "community.general",
                "--format",
                "json",
            ],
            capture_output=True,
            text=True,
        )
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        return ""
    versions = []
    for path_collections in data.values():
        if isinstance(path_collections, dict):
            entry = path_collections.get("community.general")
            if isinstance(entry, dict) and entry.get("version"):
                versions.append(entry["version"])
    if not versions:
        return ""
    return max(versions, key=version_key)


def install_ansible():
    try:
        with open("/etc/os-release") as f:
            content = f.read()
    except OSError:
        print(
            "Cannot detect this Linux distribution. Install Ansible and rerun this command.",
            file=sys.stderr,
        )
        sys.exit(1)
    distro_id = ""
    for line in content.splitlines():
        line = line.strip()
        if line.startswith("ID="):
            distro_id = line[3:].strip().strip('"')
            break
    if distro_id != "debian":
        print(
            "Unsupported distribution (v1 supports Debian stable only). Install Ansible and rerun this command.",
            file=sys.stderr,
        )
        sys.exit(1)
    prefix = ["sudo"] if shutil.which("sudo") else []
    run(prefix + ["apt-get", "update"])
    run(prefix + ["apt-get", "install", "--yes", "ansible"])


def main():
    argv = sys.argv[1:]
    saw_become_pass, saw_profile_e = prescan(argv)
    profile, passthrough = parse(argv)
    if profile not in PROFILES:
        print(
            f"Invalid profile: {profile} (expected workstation or server).",
            file=sys.stderr,
        )
        usage_error()
        sys.exit(1)

    if not shutil.which("ansible-playbook"):
        install_ansible()

    have = collection_version()
    if not have:
        run([
            "ansible-galaxy",
            "collection",
            "install",
            "-r",
            os.path.join(REPO_ROOT, "ansible", "requirements.yml"),
        ])
    elif below_floor(have):
        run([
            "ansible-galaxy",
            "collection",
            "install",
            "--upgrade",
            "-r",
            os.path.join(REPO_ROOT, "ansible", "requirements.yml"),
        ])

    os.chdir(REPO_ROOT)
    cmd = ["ansible-playbook"]
    if not saw_become_pass:
        cmd.append("--ask-become-pass")
    cmd.append("ansible/playbook.yml")
    if not saw_profile_e:
        cmd.extend(["-e", f"dotfiles_profile={profile}"])
    cmd.extend(passthrough)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
