#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.realpath(__file__))
PROFILE_DEFAULT = "workstation"
PROFILES = ("workstation", "server")
COLLECTION_FLOOR = (10, 7, 0)

DESCRIPTION = "Configure this machine via Ansible (Debian stable only)."

USAGE_NOTES = """Passthrough (anything else is forwarded to ansible-playbook):
  --tags packages|dotfiles
                    Run only app installs or only dotfile linking.
  --check --diff    Preview changes without applying them.
  --skip-tags packages
                    Limit a run to dotfile linking (no package installs).
  -e KEY=VALUE, --extra-vars KEY=VALUE
                     Extra Ansible variables. A value containing
                     dotfiles_profile overrides --profile. Only the
                     values on the command line are inspected:
                     -e @file.yml indirection is not detected, but
                     the file still wins because passthrough args
                     follow the injected default (later -e wins).

Wrapper behavior:
  - Installs ansible via apt when ansible-playbook is missing
    (Debian ID=debian only; uses sudo when available).
  - Installs (or upgrades to >=10.7.0) the community.general
    collection from ansible/requirements.yml when needed.
  - Runs ansible-playbook from the repo root with the selected
    profile forwarded as -e dotfiles_profile=NAME.
  - Conflicting dotfiles are backed up under
    ~/.local/state/dotfiles/backups/<timestamp>/ before linking.
    Re-runs are idempotent.

Examples:
  ./install
  ./install --profile server
  ./install --tags dotfiles
  ./install --tags packages
  ./install --check --diff --skip-tags packages
  ./install --profile server --tags packages
"""


def run(cmd):
    try:
        proc = subprocess.run(cmd)
    except OSError as exc:
        print(f"Failed to run {cmd[0]}: {exc}", file=sys.stderr)
        sys.exit(1)
    if proc.returncode != 0:
        sys.exit(proc.returncode)


def parse(argv):
    parser = argparse.ArgumentParser(
        prog="./install",
        description="Configure this machine via Ansible (Debian stable only).",
        epilog=USAGE_NOTES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        allow_abbrev=False,
    )
    parser.add_argument(
        "--profile",
        default=PROFILE_DEFAULT,
        choices=PROFILES,
        help="workstation: full GUI + CLI set (default); server: CLI only",
    )
    parser.add_argument(
        "-e",
        "--extra-vars",
        dest="extra_vars",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="extra Ansible variables; a value containing dotfiles_profile overrides --profile",
    )
    parser.add_argument(
        "-K",
        "--ask-become-pass",
        dest="ask_become_pass",
        action="store_true",
        help="prompt for the privilege-escalation password",
    )
    parser.add_argument(
        "--become-password-file",
        dest="become_password_file",
        metavar="FILE",
        default=None,
        help="read the privilege-escalation password from FILE",
    )
    ns, passthrough = parser.parse_known_args(argv)
    saw_become = ns.ask_become_pass or ns.become_password_file is not None
    if ns.ask_become_pass:
        passthrough.append("--ask-become-pass")
    if ns.become_password_file is not None:
        passthrough.extend(["--become-password-file", ns.become_password_file])
    for val in ns.extra_vars:
        passthrough.extend(["--extra-vars", val])
    saw_profile_e = any("dotfiles_profile" in val for val in ns.extra_vars)
    return ns.profile, passthrough, saw_profile_e, saw_become


def version_key(version):
    parts = []
    for comp in version.split("."):
        digits = ""
        for ch in comp:
            if ch.isdigit():
                digits += ch
            else:
                break
        if not digits or digits != comp:
            return (-1,)
        parts.append(int(digits))
    return tuple(parts)


def below_floor(have):
    key = version_key(have)
    if key[0] < 0:
        return True
    for h, f in zip(key, COLLECTION_FLOOR):
        if h != f:
            return h < f
    return len(key) < len(COLLECTION_FLOOR)


def collection_version():
    try:
        proc = subprocess.run(
            [
                "ansible-galaxy",
                "collection",
                "list",
                "community.general",
                "--format",
                "json",
            ],
            capture_output=True,
            text=True,
        )
    except OSError:
        return ""
    if proc.returncode != 0:
        return ""
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        return ""
    versions = []
    for path_collections in data.values():
        if isinstance(path_collections, dict):
            entry = path_collections.get("community.general")
            if isinstance(entry, dict) and entry.get("version"):
                versions.append(entry["version"])
    if not versions:
        return ""
    return max(versions, key=version_key)


def install_ansible():
    try:
        with open("/etc/os-release") as f:
            content = f.read()
    except OSError:
        print(
            "Cannot detect this Linux distribution. Install Ansible and rerun this command.",
            file=sys.stderr,
        )
        sys.exit(1)
    distro_id = ""
    for line in content.splitlines():
        line = line.strip()
        if line.startswith("ID="):
            distro_id = line[3:].strip().strip('"')
            break
    if distro_id != "debian":
        print(
            "Unsupported distribution (v1 supports Debian stable only). Install Ansible and rerun this command.",
            file=sys.stderr,
        )
        sys.exit(1)
    prefix = ["sudo"] if shutil.which("sudo") else []
    run(prefix + ["apt-get", "update"])
    run(prefix + ["apt-get", "install", "--yes", "ansible"])


def main():
    argv = sys.argv[1:]
    profile, passthrough, saw_profile_e, saw_become = parse(argv)

    # Fail before any wrapper-side collection changes when running as root:
    # linking and toolchains would land in /root instead of the user's home.
    if os.geteuid() == 0:
        print(
            "Refusing to run as root: re-run as your normal user "
            "(become handles privilege escalation).",
            file=sys.stderr,
        )
        sys.exit(1)
    # Fail clearly when sudo is required but unavailable: ansible may still
    # need privilege escalation for APT even if ansible-playbook exists.
    if not shutil.which("sudo"):
        print(
            "Warning: sudo not found; APT steps requiring privilege "
            "escalation will fail. Install sudo or run with access.",
            file=sys.stderr,
        )

    if not shutil.which("ansible-playbook"):
        install_ansible()

    have = collection_version()
    if not have:
        run([
            "ansible-galaxy",
            "collection",
            "install",
            "-r",
            os.path.join(REPO_ROOT, "ansible", "requirements.yml"),
        ])
    elif below_floor(have):
        run([
            "ansible-galaxy",
            "collection",
            "install",
            "--upgrade",
            "-r",
            os.path.join(REPO_ROOT, "ansible", "requirements.yml"),
        ])

    os.chdir(REPO_ROOT)
    cmd = ["ansible-playbook"]
    if not saw_become:
        cmd.append("--ask-become-pass")
    cmd.append("ansible/playbook.yml")
    if not saw_profile_e:
        cmd.extend(["-e", f"dotfiles_profile={profile}"])
    cmd.extend(passthrough)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
