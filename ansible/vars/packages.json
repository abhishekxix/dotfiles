{
  "$schema": "./packages.schema.json",
  "curl": {
    "source": "apt",
    "package": "curl",
    "profiles": ["workstation", "server"]
  },
  "git": {
    "source": "apt",
    "package": "git",
    "profiles": ["workstation", "server"]
  },
  "tmux": {
    "source": "apt",
    "package": "tmux",
    "profiles": ["workstation", "server"]
  },
  "zsh": {
    "source": "apt",
    "package": "zsh",
    "profiles": ["workstation", "server"]
  },
  "neovim": {
    "source": "archive",
    "url": "https://github.com/neovim/neovim/releases/download/v0.12.5/nvim-linux-x86_64.tar.gz",
    "url_arm64": "https://github.com/neovim/neovim/releases/download/v0.12.5/nvim-linux-arm64.tar.gz",
    "strip": 1,
    "dest": "~/.local/src/nvim",
    "creates": "~/.local/src/nvim/bin/nvim",
    "link": "bin/nvim",
    "profiles": ["workstation", "server"]
  },
  "fzf": {
    "source": "apt",
    "package": "fzf",
    "profiles": ["workstation", "server"]
  },
  "bat": {
    "source": "apt",
    "package": "bat",
    "profiles": ["workstation", "server"]
  },
  "unzip": {
    "source": "apt",
    "package": "unzip",
    "profiles": ["workstation", "server"]
  },
  "gnupg": {
    "source": "apt",
    "package": "gnupg",
    "profiles": ["workstation", "server"]
  },
  "ca-certificates": {
    "source": "apt",
    "package": "ca-certificates",
    "profiles": ["workstation", "server"]
  },
  "alacritty": {
    "source": "apt",
    "package": "alacritty",
    "profiles": ["workstation"]
  },
  "dunst": {
    "source": "apt",
    "package": "dunst",
    "profiles": ["workstation"]
  },
  "flameshot": {
    "source": "apt",
    "package": "flameshot",
    "profiles": ["workstation"]
  },
  "picom": {
    "source": "git",
    "repo": "https://github.com/yshui/picom.git",
    "version": "v12",
    "build": [
      "rm -rf build && meson setup --buildtype=release -Dprefix=\"$HOME/.local\" build && ninja -C build install"
    ],
    "creates": "~/.local/bin/picom",
    "profiles": ["workstation"]
  },
  "rofi": {
    "source": "apt",
    "package": "rofi",
    "profiles": ["workstation"]
  },
  "xbindkeys": {
    "source": "apt",
    "package": "xbindkeys",
    "profiles": ["workstation"]
  },
  "xscreensaver": {
    "source": "apt",
    "package": "xscreensaver",
    "profiles": ["workstation"]
  },
  "qtile": {
    "source": "apt",
    "package": "qtile",
    "profiles": ["workstation"]
  },
  "lxsession": {
    "source": "apt",
    "package": "lxsession",
    "profiles": ["workstation"]
  },
  "docker-ce": {
    "source": "apt",
    "package": "docker-ce",
    "repo": "docker",
    "profiles": ["workstation", "server"]
  },
  "vscode": {
    "source": "apt",
    "package": "code",
    "repo": "vscode",
    "profiles": ["workstation"]
  },
  "starship": {
    "source": "archive",
    "url": "https://github.com/starship/starship/releases/download/v1.22.1/starship-x86_64-unknown-linux-musl.tar.gz",
    "url_arm64": "https://github.com/starship/starship/releases/download/v1.22.1/starship-aarch64-unknown-linux-musl.tar.gz",
    "dest": "~/.local/bin",
    "creates": "~/.local/bin/starship",
    "profiles": ["workstation", "server"]
  },
  "iosevka-nerd-font": {
    "source": "archive",
    "url": "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Iosevka.tar.xz",
    "url_arm64": "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Iosevka.tar.xz",
    "dest": "~/.local/share/fonts",
    "creates": "~/.local/share/fonts/IosevkaNerdFont-Regular.ttf",
    "profiles": ["workstation"]
  },
  "zsh-syntax-highlighting": {
    "source": "git",
    "repo": "https://github.com/zsh-users/zsh-syntax-highlighting.git",
    "dest": "~/.zsh/zsh-syntax-highlighting",
    "version": "0.8.0",
    "creates": "~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh",
    "profiles": ["workstation", "server"]
  },
  "zsh-autosuggestions": {
    "source": "git",
    "repo": "https://github.com/zsh-users/zsh-autosuggestions.git",
    "dest": "~/.zsh/zsh-autosuggestions",
    "version": "v0.7.1",
    "creates": "~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh",
    "profiles": ["workstation", "server"]
  },
  "zsh-completions": {
    "source": "git",
    "repo": "https://github.com/zsh-users/zsh-completions.git",
    "dest": "~/.zsh/zsh-completions",
    "version": "0.35.0",
    "creates": "~/.zsh/zsh-completions/src/_git",
    "profiles": ["workstation", "server"]
  }
}
