###########################
# xbindkeys configuration #
###########################
#
# Bindings use symbolic keysyms/modifiers only: captured numeric
# keycode/mask lines (m:0x.. + c:...) are omitted so bindings survive a
# changed X keycode map.

"xbindkeys_show"
   control+shift + q

#brightness up (unchanged command; see spec deferred follow-ups)
"xbacklight -inc 5"
    XF86MonBrightnessUp

#brightness down
"xbacklight -dec 5"
    XF86MonBrightnessDown

#brightness 0
"xbacklight -set 0"
    XF86DisplayOff

#speaker volume up/down/mute on the default sink
"pactl set-sink-volume @DEFAULT_SINK@ +5%"
    XF86AudioRaiseVolume

"pactl set-sink-volume @DEFAULT_SINK@ -5%"
    XF86AudioLowerVolume

"pactl set-sink-mute @DEFAULT_SINK@ toggle"
    XF86AudioMute

#mic mute toggle
"pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    Control+Alt + m

#mic volume inc
"pactl set-source-volume @DEFAULT_SOURCE@ +1%"
    Control+Alt + Up

#mic vol dec
"pactl set-source-volume @DEFAULT_SOURCE@ -1%"
    Control+Alt + Down

#player pause/play
"playerctl play-pause"
    XF86AudioPlay

#player prev
"playerctl previous"
    XF86AudioPrev

#player next
"playerctl next"
    XF86AudioNext

#player stop
"playerctl stop"
    XF86AudioStop

#toggle eq
"pulseaudio-equalizer toggle"
    Control+Alt + e

#Flameshot gui
"flameshot gui"
    Print

#manual lock via XScreenSaver
"xscreensaver-command --lock"
    Mod4 + BackSpace

#manual lock then suspend; a failed lock aborts suspension
"xscreensaver-command --suspend && systemctl suspend"
    Control+Mod4 + BackSpace

#Notifications show
"dunstctl history-pop"
    Mod4 + grave

#Notification close
"dunstctl close"
    Mod4 + equal

#Notification close-all
"dunstctl close-all"
    Shift+Mod4 + equal

#
# End of xbindkeys configuration
